	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal "Traces")
		(4 "In1.Cu" signal "Ground")
		(6 "In2.Cu" signal "Power")
		(2 "B.Cu" signal "Ground2")
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
