(kicad_pcb
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(general
		(thickness 1.6)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal "F.Signal-Ground")
		(4 "In1.Cu" signal "Ground")
		(6 "In2.Cu" signal "Power")
		(2 "B.Cu" signal "B.Signal-Ground")
		(5 "F.SilkS" user "F.Silkscreen")
		(7 "B.SilkS" user "B.Silkscreen")
